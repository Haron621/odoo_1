<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- /file template -->
    <t t-name="html_editor.EmbeddedFile" t-inherit="html_editor.ReadonlyEmbeddedFile" t-inherit-mode="primary">
        <xpath expr="//span[hasclass('o_file_name_container')]" position="after">
            <input t-attf-class="rounded border-0 mx-2 #{ this.localState.editFileName ? '' : 'd-none'}"
                t-ref="this.nameInput" type="text" maxLength="100" t-att-placeholder="this.fileModel.filename"
                t-on-blur="this.onBlurNameInput" t-on-input.stop="" t-on-keydown.stop="this.onKeydownNameInput"
                t-att-value="this.fileModel.filename"/>
        </xpath>
        <xpath expr="//EmbeddedComponentToolbar" position="after">
            <t t-if="this.fileModel.isViewable">
                <button class="oi btn" data-icon="push_pin"
                    data-tooltip="Enable inline preview"
                    aria-label="Enable inline preview"
                    t-on-click="this.toggleInlinePreview"
                    t-att-class="{ 'oi-filled': this.state.isPreviewInline }"
                />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_form_pdf_controls')]" position="inside">
            <button class="oi btn btn-secondary" data-icon="push_pin"
                data-tooltip="Remove inline preview"
                aria-label="Remove inline preview"
                t-on-click="this.toggleInlinePreview"
                t-att-class="{ 'oi-filled': this.state.isPreviewInline }"
            />
        </xpath>
        <xpath expr="//span[hasclass('o_file_name_container')]" position="attributes">
            <attribute name="t-att-class">{
                "d-none": this.localState.editFileName,
                "cursor-pointer": true,
            }</attribute>
            <attribute name="t-on-focus">this.onFocusFileName</attribute>
            <attribute name="tabindex">-1</attribute>
        </xpath>
        <xpath expr="//span[hasclass('o_file_name')]" position="after">
            <i class="oi oi-filled mx-1 invisible align-items-center d-inline-flex" data-icon="edit"/>
        </xpath>
    </t>
</templates>
